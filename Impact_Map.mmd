---
config:
  theme: redux-dark-color
---
flowchart LR
    GOAL["🎯 GOAL<br/>An easy place to share, discuss and read stories<br/>in a safe, well-classified environment"]

    B("🟠 Publishers")
    C("🔵 Readers")
    D("🔴 Moderators")

    subgraph IF["🔍 IMPACT: Find exactly what they search for"]
        direction TB
        H([Search for specific books])
        I([Search by type of book])
        M([Browse by uploader])
        N([Browse by filters])
    end

    subgraph ID["💬 IMPACT: Free discussion and community"]
        direction TB
        G([Comment on books])
    end

    subgraph IA["📖 IMPACT: Easy access to books and series they like"]
        direction TB
        S([Bookmark books for later])
        L([Create book collections])
        P([Get updates on bookmarked books])
        K([Download books])
    end

    subgraph IC["🏷️ IMPACT: Keep the website organization useful for classification"]
        direction TB
        F([Classify books])
    end

    subgraph IS["📤 IMPACT: Share and maintain stories"]
        direction TB
        E([Add books])
        Q([Update book details])
    end

    subgraph IM["🛡️ IMPACT: Preserve order and usability"]
        direction TB
        O([Manage users])
        J([Remove books])
        Y([Manage comments])
        R([Send updates to users])
    end

    GOAL --> B & C & D

    B --> IF & ID & IA & IC & IS
    C --> IF & ID & IA
    D --> IF & ID & IA & IC & IS & IM

    classDef goal fill:#0f172a,stroke:#94a3b8,color:#f8fafc,font-weight:bold,stroke-width:3px
    classDef publisher fill:#7c2d12,stroke:#fb923c,color:#ffedd5,font-weight:bold,stroke-width:3px
    classDef readerActor fill:#1e3a8a,stroke:#60a5fa,color:#dbeafe,font-weight:bold,stroke-width:3px
    classDef moderator fill:#7f1d1d,stroke:#f87171,color:#fee2e2,font-weight:bold,stroke-width:3px

    classDef findD fill:#052e16,stroke:#22c55e,color:#dcfce7
    classDef discD fill:#500724,stroke:#ec4899,color:#fce7f3
    classDef accD fill:#422006,stroke:#facc15,color:#fef9c3
    classDef classD fill:#083344,stroke:#22d3ee,color:#cffafe
    classDef shareD fill:#172554,stroke:#3b82f6,color:#dbeafe
    classDef modD fill:#2e1065,stroke:#a78bfa,color:#ede9fe

    class GOAL goal
    class B publisher
    class C readerActor
    class D moderator
    class H,I,M,N findD
    class G discD
    class S,L,P,K accD
    class F classD
    class E,Q shareD
    class O,J,Y,R modD

    style IF fill:#03150b,stroke:#22c55e,stroke-width:2px,color:#dcfce7
    style ID fill:#2a0413,stroke:#ec4899,stroke-width:2px,color:#fce7f3
    style IA fill:#211003,stroke:#facc15,stroke-width:2px,color:#fef9c3
    style IC fill:#041a22,stroke:#22d3ee,stroke-width:2px,color:#cffafe
    style IS fill:#0b1230,stroke:#3b82f6,stroke-width:2px,color:#dbeafe
    style IM fill:#180a35,stroke:#a78bfa,stroke-width:2px,color:#ede9fe

    linkStyle 0,1,2 stroke:#94a3b8,stroke-width:3px
    linkStyle 3,4,5,6,7 stroke:#fb923c,stroke-width:2px
    linkStyle 8,9,10 stroke:#60a5fa,stroke-width:2px
    linkStyle 11,12,13,14,15,16 stroke:#f87171,stroke-width:2px