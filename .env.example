# Copy this file to .env and fill in the values. Never commit .env.
NODE_ENV=development
APP_MODE=local
PORT=3000
VITE_API_BASE_URL=http://localhost:3000
VITE_AUTH_MODE=local
# Public Firebase client configuration. Use the same project as the backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Optional local Firebase Auth emulator (host:port, without a scheme).
VITE_FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
# Optional backend Firebase Auth emulator (host:port, without a scheme).
FIREBASE_AUTH_EMULATOR_HOST=
# Set this to an existing Firebase Authentication UID before provisioning a moderator.
MODERATOR_UID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for book files (SPEC-002 §4). Never expose these values to VITE_ variables.
SUPABASE_BOOK_BUCKET=books
# Shared secret for the scheduled deletion worker (S2-T08). Configure the same value
# in Render and the GitHub Actions repository secret; never commit the real value.
DELETION_WORKER_SECRET=
# Opt in only after inspecting due jobs: rotating scans can reach jobs previously missed.
DELETION_WORKER_ROTATING_SCAN=false
# Exact frontend origins, comma-separated, no wildcards.
FRONTEND_ORIGIN=http://localhost:5173
