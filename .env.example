# Copy this file to .env and fill in the values. Never commit .env.
APP_MODE=local
PORT=3000
VITE_API_BASE_URL=http://localhost:3000
VITE_AUTH_MODE=local
# Public Firebase client configuration. Use the same project as the backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
# Set this to an existing Firebase Authentication UID before provisioning a moderator.
MODERATOR_UID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
CORS_ORIGIN=http://localhost:5173,https://<your-netlify-site>.netlify.app
