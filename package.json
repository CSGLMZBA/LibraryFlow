{
  "name": "library-flow",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:frontend": "npm run dev --workspace @library-flow/frontend",
    "dev:backend": "npm run dev --workspace @library-flow/backend",
    "typecheck": "npm run typecheck --workspaces"
  }
}
