{
  "name": "library-flow",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @library-flow/shared && npm run build -w @library-flow/backend -w @library-flow/frontend",
    "dev:frontend": "npm run dev --workspace @library-flow/frontend",
    "dev:backend": "npm run dev --workspace @library-flow/backend",
    "test:sprint1": "npx tsx --test docs/testing/auth-validation.test.mjs docs/testing/s1-cross-cutting.test.mjs docs/testing/s1-domain-acceptance.test.mjs",
    "test:sprint2": "npx tsx --test docs/testing/s2-publisher-application.test.mjs docs/testing/s2-t04-ui-contract.test.mjs docs/testing/s2-security-session.test.mjs docs/testing/s2-storage-deployment.test.mjs",    "test": "npm run test:sprint1 && npm run test:sprint2",
    "start": "npm run dev:backend",
    "admin:moderator": "node --env-file=.env scripts/set-moderator.mjs",
    "typecheck": "npm run typecheck -w @library-flow/shared && npm run typecheck -w @library-flow/backend -w @library-flow/frontend"
  }
}
